# ─────────────────────────────────────────────────────────────
# Edge Wood ERP — environment template. Copy to .env and fill in.
# NEVER commit real values. See docs/ENVIRONMENT.md.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
# Business timezone (dates on documents, "today" filters, daily jobs)
TZ=Africa/Cairo

# Database
# Application traffic. On Supabase use the POOLED connection (Supavisor, transaction mode, port 6543)
# and keep ?pgbouncer=true&connection_limit=... small per instance.
DATABASE_URL=postgresql://edge:edge@localhost:54329/edge_erp
# Migrations / seeds. On Supabase use the DIRECT or session-pooler connection (port 5432).
DIRECT_DATABASE_URL=postgresql://edge:edge@localhost:54329/edge_erp
# Max connections held by one app instance
DATABASE_POOL_MAX=10

# Auth — long random value (openssl rand -base64 48). Used for HMAC of session tokens.
AUTH_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12

# Storage: "local" (dev only, files under ./storage-local) or "supabase"
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage-local
SUPABASE_URL=
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key — currently unused by the app (all access goes through the API).
SUPABASE_ANON_KEY=
STORAGE_BUCKET_PREFIX=

# Uploads
MAX_UPLOAD_MB=15

# Email (notifications) — optional
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Background worker / cron shared secret (for /api/v1/cron/* endpoints)
CRON_SECRET=change-me

# Initial super admin created by `npm run db:seed` (production seed creates ONLY this + reference data)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
# Set to "true" only on dev/demo environments to load demo master data
SEED_DEMO_DATA=false
