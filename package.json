{
  "name": "edge-wood-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Edge Wood ERP - Cloud manufacturing ERP for a wooden door factory",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev -w @edge/web",
    "build": "npm run build -w @edge/web",
    "start": "npm run start -w @edge/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:local": "node scripts/dev-db.mjs",
    "db:generate": "npm run generate -w @edge/db",
    "db:migrate": "npm run migrate:dev -w @edge/db",
    "db:deploy": "npm run migrate:deploy -w @edge/db",
    "db:seed": "npm run seed -w @edge/db",
    "db:validate": "npm run validate -w @edge/db",
    "storage:init": "tsx packages/core/scripts/storage-init.ts",
    "worker": "tsx packages/core/scripts/worker.ts",
    "smoke": "node scripts/smoke.mjs",
    "backup": "node scripts/backup.mjs",
    "restore:test": "node scripts/restore-test.mjs",
    "perf": "node scripts/perf-check.mjs",
    "docs:api": "node scripts/gen-api-docs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "embedded-postgres": "17.10.0-beta.17",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
